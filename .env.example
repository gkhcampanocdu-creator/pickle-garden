# Copy to .env.local for local development, and add the same names in
# Vercel -> Project -> Settings -> Environment Variables for the live site.
# Never commit .env.local.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL (Supabase -> Project Settings -> API). Not secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# service_role key (same page). SECRET — server only, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin dashboard (/admin) ─────────────────────────────────────────────────
# Admin password. SECRET. Use a long passphrase.
ADMIN_PASSWORD=
# Random string of 32+ characters that signs the admin login cookie. SECRET.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=bookings@your-domain.com

# ── Public site settings (not secret) ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://picklegarden.vercel.app
NEXT_PUBLIC_PRICE_PER_HOUR=300
NEXT_PUBLIC_GCASH_QR_PATH=/gcash-qr.png
